# ---------------------------------------------------------------------------
# ural — переменные окружения
#
# Скопируйте в `.env` и заполните. Каждая переменная ниже действительно читается
# кодом; файл, где она читается, указан рядом. Проверить соответствие можно
# командой `pnpm run check:env-docs` — она падает, если список разошёлся с кодом.
# ---------------------------------------------------------------------------

# --- Сервер (src/server/config.ts, server.ts) ------------------------------
# Порт HTTP-сервера. По умолчанию: 3000.
PORT=3000

# Адрес прослушивания. По умолчанию 127.0.0.1: портал не виден из локальной
# сети. В контейнере или для доступа с других машин задайте 0.0.0.0.
HOST=127.0.0.1

# "production" отдаёт собранный dist/ и отключает Vite-мидлвар.
# Любое другое значение включает режим разработки. По умолчанию: development.
NODE_ENV=development

# Версия приложения, попадает в /api/health. По умолчанию: 1.0.0.
APP_VERSION=1.0.0

# Логировать каждый запрос. По умолчанию: true вне production, false в нём.
REQUEST_LOG=false

# --- Git-панель: коммит и пуш (src/server/gitService.ts) -------------------
# Personal Access Token для push. Без него коммит создаётся локально,
# а push отвечает 401. Токен не попадает в аргументы процесса — он передаётся
# git через одноразовый GIT_ASKPASS-скрипт.
GITHUB_TOKEN=

# Автор коммитов, если в репозитории не настроен git user.
GIT_USER_NAME=spawnperm
GIT_USER_EMAIL=spawnperm@gmail.com

# --- Метаданные сборки (src/server/app.ts) --------------------------------
# Ветка и SHA, отдаваемые в /api/health. Заполняются CI; локально можно не задавать.
GIT_BRANCH=main
GIT_COMMIT_SHA=unknown

# --- Запись через API (src/server/writeAuth.ts) ---------------------------
# Bearer-токен для POST /api/git/commit-push. Без него запись отключена (503),
# а не открыта: сервер без переменной не должен становиться доступным на запись.
# Чтение (/api/git/status) остаётся открытым.
WRITE_API_TOKEN=

# --- CORS (src/server/securityHeaders.ts) ---------------------------------
# Список разрешённых Origin через запятую. Пусто — CORS не включается вовсе.
CORS_ORIGINS=

# --- Ассистент по документации (src/agent/assistant.ts) -------------------
# Ключ провайдера модели. Без него POST /api/assistant/ask отвечает 503
# с перечнем нужных переменных; остальной портал работает как обычно.
LLM_API_KEY=

# Модель и, при необходимости, собственный OpenAI-совместимый endpoint.
# По умолчанию: deepseek-chat. Оставьте LLM_BASE_URL пустым для провайдера
# по умолчанию.
LLM_MODEL=deepseek-chat
LLM_BASE_URL=

# --- Temporal: оркестрация саг квеста (src/temporal/*) --------------------
# Адрес gRPC-порта Temporal. Для локального dev-сервера: 127.0.0.1:7233.
TEMPORAL_ADDRESS=127.0.0.1:7233

# Пространство имён. Локальный dev-сервер всегда использует default.
TEMPORAL_NAMESPACE=default

# Очередь задач, которую слушает воркер. Должна совпадать у клиента и воркера,
# иначе workflow запустится, но никто его не подхватит.
TEMPORAL_TASK_QUEUE=quest-orchestration
