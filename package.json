{
  "name": "ural",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Портал документации и архитектуры AR-квеста «Первооткрыватели Прикамья»",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.7.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node --experimental-transform-types server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist coverage",
    "lint": "tsc --noEmit",
    "test": "tsx --test \"src/tests/**/*.test.ts\"",
    "test:watch": "tsx --watch --test \"src/tests/**/*.test.ts\"",
    "test:coverage": "c8 --reporter=text --reporter=lcov --check-coverage --lines 70 --functions 70 --branches 65 tsx --test \"src/tests/**/*.test.ts\"",
    "check:env-docs": "node scripts/check-env-docs.mjs",
    "temporal:worker": "tsx src/temporal/worker.ts",
    "temporal:smoke": "tsx scripts/temporal-smoke.ts",
    "temporal:up": "docker compose -f docker-compose.temporal.yml up -d",
    "temporal:down": "docker compose -f docker-compose.temporal.yml down"
  },
  "dependencies": {
    "@mastra/core": "^1.85.0",
    "@scalar/express-api-reference": "^0.10.39",
    "@tailwindcss/vite": "^4.3.3",
    "@temporalio/activity": "^1.26.0",
    "@temporalio/client": "^1.26.0",
    "@temporalio/common": "^1.26.0",
    "@temporalio/worker": "^1.26.0",
    "@temporalio/workflow": "^1.26.0",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "c8": "^10.1.3",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
