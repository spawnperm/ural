* text=auto eol=lf

# Asset binaries: never let Git normalise or diff these.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.svg text eol=lf
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary

# Keep generated artefacts out of language statistics and diffs.
bun.lock linguist-generated=true
pnpm-lock.yaml linguist-generated=true
dist/** linguist-generated=true
