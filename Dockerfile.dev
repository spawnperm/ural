# Development image.
#
# Same base as the production image so the Node and pnpm versions match CI, but
# it installs dev dependencies and runs the Vite dev server instead of a prebuilt
# bundle.
#
# The source is NOT copied here. `docker-compose.dev.yml` bind-mounts the working
# tree, so an edit on the host is visible immediately and only the dependency
# install needs a rebuild.

FROM node:22-alpine

# Pin pnpm to the version in package.json's `packageManager` field: a floating
# major could resolve the lockfile differently from CI.
ARG PNPM_VERSION=11.22.0
RUN corepack enable && corepack prepare pnpm@${PNPM_VERSION} --activate

WORKDIR /app

# Manifests first: the dependency layer stays cached while source changes.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc* ./

# `--frozen-lockfile` fails loudly if the lockfile drifted — better here than in CI.
RUN pnpm install --frozen-lockfile

# `git` is required at runtime, not just for building: the commit panel shells out
# to it, and `src/server/gitService.ts` reads branch, status and log.
#
# `bash` and `curl` are for debugging inside the container (`docker compose exec`).
RUN apk add --no-cache git bash curl tini \
 && git config --system --add safe.directory /app

COPY . .

# Development runs as root inside the container: a bind mount from the Windows
# drive reports every file as owned by the host uid, so a fixed unprivileged user
# would fail to write the Vite cache. Production uses a dedicated user because
# there is no bind mount there.

EXPOSE 3000 24678

HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=5 \
  CMD node -e "fetch('http://127.0.0.1:3000/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

# tini reaps zombies and forwards SIGTERM, so the graceful shutdown handler in
# `src/server/shutdown.ts` actually runs.
ENTRYPOINT ["/sbin/tini", "--"]
CMD ["pnpm", "run", "dev"]
